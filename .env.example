# 需要的環境變數。值不要寫在這裡，請設定在 Vercel 專案的 Settings → Environment Variables。
# 本機開發：vercel env pull .env.local（.env.local 已被 .gitignore 擋住，不會被 commit）。
# 從 Vercel Marketplace 加入的 Supabase 會自動設好這些變數，名稱略有不同也沒關係（見 api/_lib/config.mjs）。

# Supabase 專案網址（Supabase → Project Settings → API）
SUPABASE_URL=

# 公開金鑰：publishable key（sb_publishable_…）或舊版 anon key。會送到瀏覽器，所以每張資料表都要開 RLS。
SUPABASE_PUBLISHABLE_KEY=

# 秘密金鑰：secret key（sb_secret_…）或舊版 service_role key。只能在伺服器用，絕不能 commit 或放進網頁。
SUPABASE_SECRET_KEY=
